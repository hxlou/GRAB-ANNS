# Copy to datasets.env and source it before running experiments.
export GRAB_DEEP_BASE=/path/to/deep_base.fvecs
export GRAB_DEEP10M_BASE=/path/to/deep10m_base.fvecs
export GRAB_DEEP_QUERY=/path/to/deep_query.fvecs
export GRAB_SIFT_BASE=/path/to/sift_base.fvecs
export GRAB_SIFT_QUERY=/path/to/sift_query.fvecs
export GRAB_GIST_BASE=/path/to/gist_base.fvecs
export GRAB_GIST_QUERY=/path/to/gist_query.fvecs
export GRAB_WIT_BASE=/path/to/wit_base.fvecs
export GRAB_WIT_QUERY=/path/to/wit_query.fvecs
